# Copy this file to .env and fill in the values. Never commit .env.

# Leave the token empty to run the API without the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_ADDRESS=
SOLANA_KEYPAIR_PATH=

# Sent in the X-Api-Key header on /api/sol
API_KEY=

# false keeps payouts paused until an admin resumes them.
SOLANA_PAYOUT_ENABLED=false
SOLANA_MAX_PAYOUT=1
SOLANA_MIN_RESERVE=0.02

SOLANA_MAX_PRIORITY_FEE_LAMPORTS=10000
SOLANA_FEE_BUFFER_LAMPORTS=20000
SOLANA_CONFIRMATION_COMMITMENT=finalized

DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=DBName;Username=username;Password=password;Pooling=true;Maximum Pool Size=200
